# PostgreSQL connection used by the API, the jobs and Alembic.
# Matches the `db` service in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://datos:datos@localhost:5432/datos

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# true: JSON lines (deployments). false: readable console output (local development).
LOG_JSON=false

# The classifier whose stored labels the news API reads (ADR-0015): `rules` until the own
# model is promoted.
ACTIVE_CLASSIFIER_ID=rules

# docker-compose.yml (local development only)
POSTGRES_USER=datos
POSTGRES_PASSWORD=datos
POSTGRES_DB=datos
POSTGRES_PORT=5432
LABEL_STUDIO_PORT=8080
# pgAdmin (profile `tools`): http://localhost:5050, desktop mode, local only
PGADMIN_PORT=5050
# docker compose --profile app (host ports of the API and the web app)
API_PORT=8000
WEB_PORT=3000
# docker compose --profile app: minutes between two collections by the `collector` service.
# Not below a few hours: it reads every feed each time (docs/sources-audit.md).
COLLECT_INTERVAL_MIN=180
