<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs scripts/update-stories.sh every hour, so a new article has its story and tree within the hour
  (the script groups again only when an article was embedded since the latest run). launchd never
  starts a run while the previous one is still going, and runs missed while the Mac sleeps happen
  once on wake. Replace REPO with the absolute path of
  this repository, then:
    cp scripts/launchd/es.datos.update-stories.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/es.datos.update-stories.plist
  To stop it:
    launchctl bootout gui/$(id -u)/es.datos.update-stories
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>es.datos.update-stories</string>
  <key>ProgramArguments</key>
  <array>
    <string>REPO/scripts/update-stories.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>StandardOutPath</key>
  <string>REPO/var/log/update-stories.log</string>
  <key>StandardErrorPath</key>
  <string>REPO/var/log/update-stories.log</string>
</dict>
</plist>
