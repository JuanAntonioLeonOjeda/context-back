<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs scripts/collect-news.sh every 3 hours. A run missed while the Mac sleeps happens
  once on wake. Replace REPO with the absolute path of this repository, then:
    cp scripts/launchd/es.datos.collect-news.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/es.datos.collect-news.plist
  To stop it:
    launchctl bootout gui/$(id -u)/es.datos.collect-news
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>es.datos.collect-news</string>
  <key>ProgramArguments</key>
  <array>
    <string>REPO/scripts/collect-news.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>10800</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardErrorPath</key>
  <string>REPO/var/log/collect-news.launchd.log</string>
</dict>
</plist>
